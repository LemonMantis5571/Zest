# Copy to .env — .env is gitignored.
#
# Codex via CLIProxyAPI (first live path):
#   1. Install and run CLIProxyAPI on :8317
#   2. Authenticate it: cliproxyapi -codex-login  (or equivalent on your install)
#   3. Put the same client token the proxy's api-keys list accepts here
ZEST_GATEWAY_KEY=claudex-replace-with-a-random-secret

# Optional overrides
# ZEST_MODEL=gpt-5.6-sol
# ZEST_EFFORT=high

# One-off gateway override without editing zest.toml. Origin only — no
# /v1/messages suffix. Uses ZEST_GATEWAY_KEY (falls back to ANTHROPIC_API_KEY).
# ZEST_BASE_URL=http://127.0.0.1:8317

# Native Anthropic (when you add [providers.anthropic] back in zest.toml)
# ANTHROPIC_API_KEY=sk-ant-...
