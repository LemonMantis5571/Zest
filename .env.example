# Copy to .env — .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ZEST_MODEL=claude-opus-5
# ZEST_EFFORT=high

# Route through a gateway that speaks the Messages API instead of calling
# Anthropic directly. Origin only - no /v1/messages suffix.
# When this is set to a non-Anthropic host, `thinking` and `output_config.effort`
# are dropped, since a GPT/Gemini backend has no use for them.
#
# Example: CLIProxyAPI with a Codex login
#   ZEST_BASE_URL=http://127.0.0.1:8317
#   ZEST_MODEL=gpt-5.3-codex
#   ANTHROPIC_API_KEY=<whatever key the gateway is configured to accept>
# ZEST_BASE_URL=
