{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zest",
  "version": "0.1.0",
  "identifier": "dev.zest.app",
  "build": {
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Zest",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/zest-icon-32.png",
      "icons/zest-icon-128.png",
      "icons/zest-icon.png",
      "icons/zest-icon.ico"
    ]
  }
}
